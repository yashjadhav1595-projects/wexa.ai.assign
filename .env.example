# --- CognoDB / Neo4j Graph Database ---
COGNODB_URI=bolt+s://YOUR_INSTANCE_ID.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=your_generated_password_here

# --- Server Configuration ---
PORT=3000
NODE_ENV=development

# --- GitHub App & Developer Program Configuration ---
# Obtain from GitHub Settings -> Developer settings -> GitHub Apps -> [Your App]
APP_ID=123456
PRIVATE_KEY_PATH="./private-key.pem"
# Or provide the RSA key string directly:
# PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Webhook Secret (Configured in GitHub App settings)
WEBHOOK_SECRET=your_webhook_secret_here

# OAuth App Credentials (Optional)
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret

# GitHub Personal Access Token (Optional, boosts unauthenticated rate limit from 60 to 5000/hr)
GITHUB_TOKEN=ghp_your_token_here

# Support & Compliance (GitHub Developer Program requirement)
SUPPORT_EMAIL=yashjadhav.career@gmail.com
HOMEPAGE_URL=https://wexa-ai-assign.vercel.app
